<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/webp" href="/favicon.webp">
    <link rel="icon" type="image/png" href="/favicon.png">
    <meta
      name="description"
      :content="description || 'Cocoboko Studios is an indie game development team passionate about creating immersive, innovative, and fun experiences for gamers worldwide.'"
    >
    <link rel="stylesheet" href="/assets/site.css" webc:keep>
    <script src="/assets/alpine.js" defer webc:keep></script>
    <title @text="title || 'Cocoboko Studios - An Independent Game Studio in Development'">
      Cocoboko Studios - An Independent Game Studio in Development
    </title>
    <mailer-lite-header webc:if="usesMailerLite"></mailer-lite-header>
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-gray-700 antialiased">
    <site-navigation></site-navigation>
    <div class="flex-1" @raw="content"></div>
    <site-footer></site-footer>
    <site-analytics></site-analytics>
  </body>
</html>
