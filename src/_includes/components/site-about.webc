    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">About</p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-gray-900">The Goal</h2>
      <p class="mt-6 text-lg leading-8 text-gray-600">
