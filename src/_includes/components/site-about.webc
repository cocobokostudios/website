<section id="about" class="border-y border-gray-100 bg-gray-50">
  <div class="container mx-auto grid max-w-6xl gap-12 px-6 py-20 lg:grid-cols-2 lg:items-center lg:px-8 lg:py-28">
    <img
      class="aspect-[4/3] w-full rounded-lg object-cover"
