<div class="w-full max-w-2xl" webc:root="override">
  <form
    class="rounded-3xl border border-slate-600 bg-slate-900/80 p-6 text-slate-100 shadow-2xl shadow-slate-950/30 sm:p-8"
    data-newsletter-form
    action="/api/newsletter-subscribe"
    method="post"
    novalidate
  >
    <div class="space-y-3">
      <p class="text-sm font-semibold uppercase tracking-[0.25em] text-amber-300">Newsletter</p>
      <h2 class="text-2xl font-bold text-white sm:text-3xl">Get Cocoboko Studios updates</h2>
      <p class="text-base leading-7 text-slate-300">
        Subscribe for Cocoboko Studios updates, devlogs, release news, and occasional product announcements.
      </p>
      <p class="text-sm text-slate-400">We only ask for your email address, and you can unsubscribe anytime.</p>
    </div>

    <div class="mt-6 grid gap-3 sm:grid-cols-[1fr_auto]">
      <div>
        <label class="sr-only" for="newsletter-email">Email address</label>
        <input
          class="min-h-12 w-full rounded-xl border border-slate-500 bg-slate-950 px-4 py-3 text-base text-white placeholder:text-slate-500 outline-none transition focus:border-amber-300 focus:ring-2 focus:ring-amber-300/40"
          id="newsletter-email"
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          placeholder="you@example.com"
          required
          data-newsletter-email
          aria-describedby="newsletter-help newsletter-message"
        >
      </div>
      <button
        class="min-h-12 rounded-xl bg-amber-300 px-6 py-3 text-base font-semibold text-slate-950 transition hover:bg-amber-200 focus:outline-none focus:ring-2 focus:ring-amber-100 focus:ring-offset-2 focus:ring-offset-slate-900 disabled:cursor-not-allowed disabled:opacity-60"
        type="submit"
        data-newsletter-submit
      >
        Notify me
      </button>
    </div>

    <p id="newsletter-help" class="mt-3 text-xs leading-5 text-slate-400">
      By subscribing, you agree to receive newsletter emails from Cocoboko Studios. No third-party signup script is loaded on this page.
    </p>
    <p id="newsletter-message" class="mt-4 rounded-xl border border-transparent px-4 py-3 text-sm" data-newsletter-message aria-live="polite" hidden></p>
  </form>
</div>

<script webc:keep>
  (() => {
    const form = document.querySelector('[data-newsletter-form]');
    if (!form) return;

    const email = form.querySelector('[data-newsletter-email]');
    const submit = form.querySelector('[data-newsletter-submit]');
    const message = form.querySelector('[data-newsletter-message]');

    const copy = {
      required: 'Please enter your email address.',
      invalid: 'Please enter a valid email address.',
      success: 'Thanks! Please check your inbox to confirm your subscription.',
      error: 'Sorry, we could not subscribe you right now. Please try again later.',
    };

    const setMessage = (text, type) => {
      message.textContent = text;
      message.hidden = false;
      message.className = 'mt-4 rounded-xl border px-4 py-3 text-sm';
      if (type === 'success') {
        message.classList.add('border-emerald-400/40', 'bg-emerald-500/10', 'text-emerald-100');
      } else {
        message.classList.add('border-rose-400/40', 'bg-rose-500/10', 'text-rose-100');
      }
    };

    const validate = () => {
      if (!email.value.trim()) return copy.required;
      if (!email.validity.valid) return copy.invalid;
      return '';
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const validationMessage = validate();
      if (validationMessage) {
        email.setAttribute('aria-invalid', 'true');
        setMessage(validationMessage, 'error');
        email.focus();
        return;
      }

      email.removeAttribute('aria-invalid');
      submit.disabled = true;
      submit.textContent = 'Subscribing…';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ email: email.value.trim() }),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || result.status !== 'success') throw new Error('subscription failed');
        setMessage(result.message || copy.success, 'success');
        form.reset();
      } catch {
        setMessage(copy.error, 'error');
      } finally {
        submit.disabled = false;
        submit.textContent = 'Notify me';
      }
    });
  })();
</script>
