<div
  class="relative mx-auto min-h-[405px] max-w-xl text-left"
  data-mailerlite-root
  aria-busy="true"
  webc:root="override"
>
  <div class="ml-embedded" data-form="2g04OZ" data-mailerlite-embed></div>

  <div
    class="absolute inset-0 animate-pulse rounded border border-gray-200 bg-gray-50 p-6"
    data-mailerlite-placeholder
    role="status"
  >
    <span class="sr-only">Loading the newsletter signup form…</span>
    <div aria-hidden="true">
      <div class="h-6 w-2/3 rounded bg-gray-200"></div>
      <div class="mt-4 h-4 w-full rounded bg-gray-200"></div>
      <div class="mt-2 h-4 w-4/5 rounded bg-gray-200"></div>
      <div class="mt-8 h-4 w-24 rounded bg-gray-200"></div>
      <div class="mt-3 h-12 w-full rounded bg-gray-200"></div>
      <div class="mt-4 h-12 w-full rounded bg-indigo-200"></div>
    </div>
  </div>
</div>

<script webc:keep>
  (() => {
    const root = document.querySelector('[data-mailerlite-root]');
    if (!root) return;

    const embed = root.querySelector('[data-mailerlite-embed]');
    const placeholder = root.querySelector('[data-mailerlite-placeholder]');

    if (!embed || !placeholder) return;

    const showForm = () => {
      if (embed.childElementCount === 0) return;

      placeholder.hidden = true;
      root.setAttribute('aria-busy', 'false');
      observer.disconnect();
    };

    const observer = new MutationObserver(showForm);

    observer.observe(embed, { childList: true, subtree: true });
    showForm();
  })();
</script>
