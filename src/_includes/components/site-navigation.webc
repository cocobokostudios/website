<header class="border-b border-gray-100 bg-white/95 backdrop-blur" webc:root="override">
  <nav
    class="container mx-auto flex min-h-20 flex-wrap items-center px-6 lg:px-8"
    aria-label="Primary"
    x-data="{ isOpen: false }"
    x-on:keydown.escape.window="isOpen = false"
  >
    <a href="/" class="flex items-center gap-3 font-bold text-indigo-600">
      <img class="size-9 rounded-full" src="/images/logo.webp" alt="">
      <span>Cocoboko Studios</span>
    </a>

    <button
      class="ml-auto rounded p-2 text-gray-500 hover:text-indigo-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 lg:hidden"
      type="button"
      aria-label="Toggle navigation"
      aria-controls="primary-menu"
      x-on:click="isOpen = !isOpen"
      x-bind:aria-expanded="isOpen"
    >
      <svg class="size-6 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
        <path x-cloak x-show="isOpen" fill-rule="evenodd" clip-rule="evenodd" d="M18.278 16.864a1 1 0 0 1-1.414 1.414l-4.829-4.828-4.828 4.828a1 1 0 0 1-1.414-1.414l4.828-4.829-4.828-4.828a1 1 0 0 1 1.414-1.414l4.829 4.828 4.828-4.828a1 1 0 1 1 1.414 1.414l-4.828 4.829 4.828 4.828z"></path>
        <path x-show="!isOpen" fill-rule="evenodd" d="M4 5h16a1 1 0 0 1 0 2H4a1 1 0 1 1 0-2zm0 6h16a1 1 0 0 1 0 2H4a1 1 0 0 1 0-2zm0 6h16a1 1 0 0 1 0 2H4a1 1 0 0 1 0-2z"></path>
      </svg>
    </button>

    <div
      id="primary-menu"
      class="w-full lg:ml-auto lg:block lg:w-auto"
      x-bind:class="isOpen ? 'block' : 'hidden'"
      x-on:click.outside="isOpen = false"
    >
      <ul class="pt-5 text-center lg:flex lg:items-center lg:gap-1 lg:pt-0">
        <li><a class="block px-4 py-2 text-gray-500 hover:text-indigo-600" href="/" x-on:click="isOpen = false">Home</a></li>
        <li><a class="block px-4 py-2 text-gray-500 hover:text-indigo-600" href="/#get-notified" x-on:click="isOpen = false">Get Notified</a></li>
        <li><a class="block px-4 py-2 text-gray-500 hover:text-indigo-600" href="/#about" x-on:click="isOpen = false">About</a></li>
        <li><a class="block px-4 py-2 text-gray-500 hover:text-indigo-600" href="/#games" x-on:click="isOpen = false">Games</a></li>
      </ul>
    </div>
  </nav>
</header>
