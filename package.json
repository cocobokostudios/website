{
  "name": "cocoboko-website",
  "type": "module",
  "version": "1.0.1",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "description": "Cocoboko Studios website, built with Eleventy and WebC",
  "scripts": {
    "dev": "pnpm run build:images && concurrently \"pnpm:dev:css\" \"pnpm:dev:site\"",
    "dev:css": "tailwindcss -i ./src/styles/global.css -o ./public/assets/site.css --watch",
    "dev:site": "eleventy --serve --port=4321",
    "build": "rimraf dist && pnpm run sync:analytics && pnpm run build:css && pnpm run build:images && pnpm run build:site",
    "build:css": "tailwindcss -i ./src/styles/global.css -o ./public/assets/site.css --minify",
    "build:images": "node scripts/build-images.js",
    "build:site": "eleventy",
    "preview": "http-server dist -a 127.0.0.1 -p 4321 -c-1 --silent",
    "test": "pnpm run test:api && pnpm run test:e2e",
    "test:api": "pnpm --dir api test",
    "test:e2e": "playwright test",
    "sync:analytics": "node ./scripts/sync-simple-analytics.mjs"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-webc": "^0.11.2",
    "@tailwindcss/typography": "^0.5.20",
    "concurrently": "^10.0.3",
    "http-server": "^14.1.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@11ty/eleventy-img": "^6.0.4",
    "@playwright/test": "^1.61.0"
  }
}
